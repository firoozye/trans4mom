# Data & Weights
weights/
outputs/

# Ignore all parquet by default
*.parquet

# Explicitly allow yfinance/crypto datasets (non-DataBento)
!data/raw/*.parquet
!data/raw/futures_1990/
!data/raw/futures_1990/*.parquet
!data/processed/futures_1990_present.parquet

# Explicitly keep DataBento data ignored (License restricted)
data/raw/futures/
data/raw/futures_v2/
data/processed/futures_2010_present.parquet

# Pinnacle Proprietary Data & Credentials (Strict T&C protection)
data/PinnacleData/
data/raw/pinnacle/
data/processed/pinnacle/
data/processed/pinnacle*.parquet
*.clc
*.clc.*
*.RAD
*.LNG
*.NON
*.PIN
*.ASC
.pinnacle_*


# Ignore all markdown files
*.md

# Explicitly include research images
!research/*.png
!docs/Figures/*.png

# Python & Environment
__pycache__/
.ipynb_checkpoints/
.env
.env.*

# LaTeX auxiliary files
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
# Keep .bbl to ensure bibliography is portable
!*.bbl
*.bcf
*.blg
*.run.xml
